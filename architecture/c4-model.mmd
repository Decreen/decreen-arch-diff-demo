%% ============================================================
%% L3: Component – FastAPI Backend
%% ============================================================
%% SCOPE: urn:c4:container:backend

graph TD

  subgraph backend["FastAPI Backend"]

    subgraph middleware["Middleware Layer"]
      %% KIND: boundary
      cors_mw["CORS Middleware\n[Component: Starlette]\nEnforces allowed origins,\ncredentials, methods, headers"]

      %% KIND: boundary
      auth_deps["Auth Dependencies\n[Component: FastAPI Depends]\nOAuth2 bearer token extraction,\nJWT decode, current-user resolution"]
    end

    subgraph routes["API Routes"]
      %% KIND: router
      login_routes["Login Routes\n[Component: APIRouter]\n/login/access-token\n/password-recovery\n/reset-password"]

      %% KIND: router
      user_routes["User Routes\n[Component: APIRouter]\n/users CRUD, /users/me,\n/users/signup, /users/{id}"]

      %% KIND: router
      item_routes["Item Routes\n[Component: APIRouter]\n/items CRUD with\nowner-based access control"]

      %% KIND: router
      util_routes["Utility Routes\n[Component: APIRouter]\n/utils/health-check,\n/utils/test-email"]
    end

    subgraph services["Service Layer"]
      %% KIND: service_layer
      crud_layer["CRUD Operations\n[Component: Python Module]\nUser & Item create/read/update/delete,\nauthenticate with timing-safe compare"]

      %% KIND: integration
      email_utils["Email Utilities\n[Component: Python Module]\nJinja2 template rendering,\nSMTP dispatch, token generation"]
    end

    subgraph core["Core Infrastructure"]
      %% KIND: service_layer
      security_core["Security Module\n[Component: PyJWT, pwdlib]\nJWT token creation, HS256 signing,\nArgon2/Bcrypt password hashing"]

      %% KIND: service_layer
      config_core["Configuration\n[Component: Pydantic Settings]\nEnvironment-based settings,\nCORS origins, DB URI, SMTP config"]

      %% KIND: storage
      db_engine["Database Engine\n[Component: SQLAlchemy Engine]\nConnection pooling and session\nmanagement for PostgreSQL"]

      %% KIND: data_access
      models_layer["SQLModel Models\n[Component: SQLModel]\nUser & Item table definitions,\nPydantic schemas for API I/O"]
    end

  end

  %% --- External nodes referenced from L2 ---
  pg["🐘 PostgreSQL\n[Container]"]
  smtp["📧 SMTP Server\n[External System]"]
  sentry["📊 Sentry\n[External System]"]

  %% --- Request flow ---
  cors_mw --> auth_deps
  auth_deps --> login_routes
  auth_deps --> user_routes
  auth_deps --> item_routes
  auth_deps --> util_routes

  %% --- Routes to services ---
  login_routes -- "authenticate,\nupdate_user" --> crud_layer
  login_routes -- "create_access_token,\nverify_password" --> security_core
  login_routes -- "generate & send\nreset email" --> email_utils

  user_routes -- "create/read/update/\ndelete users" --> crud_layer
  user_routes -- "hash & verify\npasswords" --> security_core
  user_routes -- "send new account\nemail" --> email_utils

  item_routes -- "create/read/update/\ndelete items" --> crud_layer

  util_routes -- "send test email" --> email_utils

  %% --- Services to core ---
  crud_layer -- "query & persist\nentities" --> models_layer
  crud_layer -- "hash & verify\npasswords" --> security_core
  models_layer -- "execute SQL via\nSQLAlchemy sessions" --> db_engine
  security_core -- "reads SECRET_KEY,\nalgorithm config" --> config_core
  email_utils -- "reads SMTP config,\nFRONTEND_HOST" --> config_core

  %% --- Core to external ---
  db_engine -- "SQL / TCP :5432" --> pg
  email_utils -- "SMTP/TLS" --> smtp
  cors_mw -. "Sentry SDK init\n(app startup)" .-> sentry

%% ============================================================
%% STYLES – L3 Backend
%% ============================================================
  classDef component fill:#438dd5,stroke:#2e6ca0,color:#fff
  classDef subgraphStyle fill:#e8f0fe,stroke:#1168bd,color:#1168bd
  classDef storage fill:#2b78c4,stroke:#1a5a96,color:#fff
  classDef external fill:#999999,stroke:#6b6b6b,color:#fff

  class cors_mw,auth_deps,login_routes,user_routes,item_routes,util_routes component
  class crud_layer,email_utils,security_core,config_core,db_engine,models_layer component
  class pg storage
  class smtp,sentry external

