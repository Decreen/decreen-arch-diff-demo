%% ============================================================
%% L2: Container – Full Stack FastAPI Platform
%% ============================================================
%% SCOPE: urn:c4:system:fullstack-fastapi-platform

graph TD

  subgraph users["Users"]
    user["👤 End User\n[Person]"]
    admin_user["👤 Administrator\n[Person]"]
  end

  subgraph system_boundary["Full Stack FastAPI Platform"]
    %% KIND: boundary
    traefik["🔀 Traefik\n[Container: Traefik 3.6]\nReverse proxy, TLS termination,\nroute-based load balancing"]

    %% KIND: boundary
    frontend["⚛️ React SPA\n[Container: TypeScript, React 19, Vite]\nSingle-page dashboard application\nwith TanStack Router & shadcn/ui"]

    %% KIND: service_layer
    backend["🐍 FastAPI Backend\n[Container: Python, FastAPI, SQLModel]\nREST API serving /api/v1 endpoints\nwith JWT auth and CORS"]

    %% KIND: worker
    prestart["🚀 Prestart Job\n[Container: Python, Alembic]\nRuns DB migrations and seeds\ninitial superuser on deploy"]

    %% KIND: storage
    pg["🐘 PostgreSQL\n[Container: PostgreSQL 18]\nPrimary relational data store\nfor users and items"]

    %% KIND: boundary
    adminer["🔧 Adminer\n[Container: PHP]\nLightweight database\nadministration UI"]
  end

  subgraph external["External Systems"]
    smtp["📧 SMTP Server\n[External System]"]
    sentry["📊 Sentry\n[External System]"]
  end

  user -- "HTTPS" --> traefik
  admin_user -- "HTTPS" --> traefik

  traefik -- "dashboard.{domain}\n[HTTP :80]" --> frontend
  traefik -- "api.{domain}\n[HTTP :8000]" --> backend
  traefik -- "adminer.{domain}\n[HTTP :8080]" --> adminer

  frontend -- "REST API calls\n[JSON/HTTP]" --> backend

  backend -- "SQL queries\n[psycopg / TCP :5432]" --> pg
  backend -- "Sends emails\n[SMTP/TLS]" --> smtp
  backend -- "Error reports\n[HTTPS]" --> sentry

  prestart -- "Alembic migrations\n& initial seed\n[psycopg / TCP :5432]" --> pg

  adminer -- "Database management\n[SQL / TCP :5432]" --> pg

%% ============================================================
%% STYLES – L2
%% ============================================================
  classDef person fill:#08427b,stroke:#052e56,color:#fff
  classDef container fill:#1168bd,stroke:#0b4884,color:#fff
  classDef storage fill:#2b78c4,stroke:#1a5a96,color:#fff
  classDef external fill:#999999,stroke:#6b6b6b,color:#fff

  class user,admin_user person
  class traefik,frontend,backend,prestart,adminer container
  class pg storage
  class smtp,sentry external

