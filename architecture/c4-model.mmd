%% ============================================================
%% L3: Component – React SPA (Frontend)
%% ============================================================
%% SCOPE: urn:c4:container:frontend

graph TD

  subgraph frontend["React SPA"]

    subgraph routing_layer["Routing & State"]
      %% KIND: router
      tanstack_router["TanStack File Router\n[Component: @tanstack/react-router]\nFile-based routing with guards,\nredirects unauthenticated to /login"]

      %% KIND: service_layer
      query_client["Query Client\n[Component: @tanstack/react-query]\nServer state cache, mutations,\nauto error handling for 401/403"]

      %% KIND: service_layer
      auth_hook["useAuth Hook\n[Component: React Hook]\nLogin/logout/signup mutations,\ncurrent-user query, token management"]
    end

    subgraph data_layer["Data Layer"]
      %% KIND: integration
      api_client["API Client SDK\n[Component: @hey-api/openapi-ts]\nAuto-generated typed HTTP client\n(ItemsService, UsersService, LoginService)"]
    end

    subgraph feature_views["Feature Views"]
      %% KIND: boundary
      dashboard_view["Dashboard View\n[Component: React Page]\nWelcome page showing\ncurrent user greeting"]

      %% KIND: boundary
      admin_view["Admin Panel\n[Component: React Page]\nUser management: list, add,\nedit, delete users (superuser)"]

      %% KIND: boundary
      items_view["Items View\n[Component: React Page]\nItem CRUD: list, create,\nedit, delete with pagination"]

      %% KIND: boundary
      settings_view["User Settings\n[Component: React Page]\nProfile info, change password,\ndelete account"]

      %% KIND: boundary
      login_view["Auth Views\n[Component: React Pages]\nLogin, signup, password\nrecovery, password reset"]
    end

    subgraph ui_framework["UI Framework"]
      %% KIND: boundary
      sidebar_nav["Sidebar Navigation\n[Component: React Component]\nApp sidebar with route links,\nuser menu, collapsible layout"]

      %% KIND: boundary
      ui_primitives["UI Primitives\n[Component: shadcn/ui + Radix]\nButton, Dialog, DataTable, Form,\nInput, Select, Tabs, Tooltip, etc."]

      %% KIND: service_layer
      theme_mgr["Theme Provider\n[Component: next-themes]\nDark/light mode toggle,\npersisted in localStorage"]
    end

  end

  %% --- External nodes referenced from L2 ---
  backend["🐍 FastAPI Backend\n[Container]"]

  %% --- Routing flows ---
  tanstack_router -- "renders" --> dashboard_view
  tanstack_router -- "renders" --> admin_view
  tanstack_router -- "renders" --> items_view
  tanstack_router -- "renders" --> settings_view
  tanstack_router -- "renders" --> login_view

  %% --- Auth flows ---
  login_view -- "login/signup\nmutations" --> auth_hook
  auth_hook -- "queries & mutations\nvia QueryClient" --> query_client

  %% --- Data flows ---
  admin_view -- "useQuery/useMutation" --> query_client
  items_view -- "useQuery/useMutation" --> query_client
  settings_view -- "useQuery/useMutation" --> query_client
  dashboard_view -- "useQuery" --> query_client

  query_client -- "delegates HTTP\ncalls to SDK" --> api_client

  %% --- UI composition ---
  dashboard_view -- "uses" --> sidebar_nav
  admin_view -- "uses" --> ui_primitives
  items_view -- "uses" --> ui_primitives
  settings_view -- "uses" --> ui_primitives
  login_view -- "uses" --> ui_primitives

  %% --- External ---
  api_client -- "REST API\n[JSON/HTTP]" --> backend

%% ============================================================
%% STYLES – L3 Frontend
%% ============================================================
  classDef component fill:#438dd5,stroke:#2e6ca0,color:#fff
  classDef external fill:#1168bd,stroke:#0b4884,color:#fff

  class tanstack_router,query_client,auth_hook,api_client component
  class dashboard_view,admin_view,items_view,settings_view,login_view component
  class sidebar_nav,ui_primitives,theme_mgr component
  class backend external

