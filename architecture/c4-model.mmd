%% ============================================================
%% L1: System Context – Full Stack FastAPI Platform
%% ============================================================
%% SCOPE: urn:c4:system:fullstack-fastapi-platform

graph TD

  subgraph users["Users"]
    user["👤 End User\n[Person]\nRegular application user who\nmanages personal items"]
    admin_user["👤 Administrator\n[Person]\nSuperuser with full access\nto manage all users and items"]
  end

  subgraph system_boundary["Full Stack FastAPI Platform"]
    system["Full Stack FastAPI Platform\n[Software System]\nWeb application for managing\nusers and items with JWT\nauthentication and role-based access"]
  end

  subgraph external["External Systems"]
    smtp["📧 SMTP Server\n[External System]\nEmail delivery service for\npassword recovery and notifications"]
    sentry["📊 Sentry\n[External System]\nError monitoring, tracing,\nand performance tracking"]
  end

  user -- "Browses dashboard,\nmanages own items\n[HTTPS]" --> system
  admin_user -- "Administers users & items,\nsends test emails\n[HTTPS]" --> system
  system -- "Sends transactional emails\n(password recovery, new account)\n[SMTP/TLS]" --> smtp
  system -- "Reports errors\nand performance traces\n[HTTPS]" --> sentry

