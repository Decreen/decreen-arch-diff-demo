title: "L3: Component Diagram — React SPA"
---

C4Component

    Container_Boundary(spa, "React SPA") {

        %% ── Routing ─────────────────────────────────────────────────────
        %% KIND: router
        Component(tanstack_router, "TanStack Router", "TanStack Router, File-based routing", "Defines routes: /login, /signup, /recover-password, /reset-password, /_layout (admin, items, settings)")

        %% ── State & Data ────────────────────────────────────────────────
        %% KIND: service_layer
        Component(auth_hooks, "Auth Hooks", "React hooks, TanStack Query", "useAuth: login/signup/logout mutations, current user query, token management in localStorage")

        %% KIND: integration
        Component(api_client, "API Client", "Auto-generated from OpenAPI (@hey-api/openapi-ts)", "ItemsService, LoginService, UsersService, UtilsService — typed HTTP calls to /api/v1/*")

        %% ── Feature Components ──────────────────────────────────────────
        %% KIND: boundary
        Component(admin_components, "Admin Components", "React, TanStack Table", "AddUser, EditUser, DeleteUser, UserActionsMenu, columns — admin user management UI")

        %% KIND: boundary
        Component(items_components, "Items Components", "React, TanStack Table", "AddItem, EditItem, DeleteItem, ItemActionsMenu, columns — item CRUD UI")

        %% KIND: boundary
        Component(settings_components, "UserSettings Components", "React, react-hook-form, Zod", "UserInformation, ChangePassword, DeleteAccount, DeleteConfirmation")

        %% ── Shared UI ───────────────────────────────────────────────────
        %% KIND: boundary
        Component(ui_lib, "UI Component Library", "shadcn/ui, Radix UI, Tailwind CSS", "Button, Dialog, Form, Table, Sidebar, Tabs, Tooltip, and 20+ reusable primitives")

        %% KIND: service_layer
        Component(theme_provider, "Theme Provider", "next-themes", "Dark/light mode toggle and system preference detection")
    }

    %% ── External elements ───────────────────────────────────────────────
    Container(fastapi_backend, "FastAPI Backend", "Python, FastAPI", "REST API")

    %% ── Relationships ───────────────────────────────────────────────────
    Rel(tanstack_router, auth_hooks, "Guards routes, checks isLoggedIn()")
    Rel(tanstack_router, admin_components, "Renders on /_layout/admin")
    Rel(tanstack_router, items_components, "Renders on /_layout/items")
    Rel(tanstack_router, settings_components, "Renders on /_layout/settings")

    Rel(auth_hooks, api_client, "Calls LoginService, UsersService")
    Rel(admin_components, api_client, "Calls UsersService for CRUD")
    Rel(items_components, api_client, "Calls ItemsService for CRUD")
    Rel(settings_components, api_client, "Calls UsersService for profile/password updates")

    Rel(admin_components, ui_lib, "Uses shared UI primitives")
    Rel(items_components, ui_lib, "Uses shared UI primitives")
    Rel(settings_components, ui_lib, "Uses shared UI primitives")

    Rel(tanstack_router, ui_lib, "Layout uses Sidebar, SidebarProvider")
    Rel(tanstack_router, theme_provider, "Wraps app in ThemeProvider")

    Rel(api_client, fastapi_backend, "HTTP calls to /api/v1/*", "HTTPS")


