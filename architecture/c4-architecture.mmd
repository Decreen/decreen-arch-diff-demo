---
title: "L3: Component Diagram — FastAPI Backend"
---

C4Component

    Container_Boundary(fastapi_backend, "FastAPI Backend") {

        %% ── Middleware ──────────────────────────────────────────────────
        %% KIND: boundary
        Component(cors_mw, "CORS Middleware", "Starlette CORSMiddleware", "Enforces allowed origins from BACKEND_CORS_ORIGINS and FRONTEND_HOST settings")

        %% ── Auth & Dependency Injection ─────────────────────────────────
        %% KIND: service_layer
        Component(auth_deps, "Auth Dependencies", "FastAPI Depends, PyJWT, OAuth2PasswordBearer", "Provides SessionDep, TokenDep, CurrentUser, and superuser guard via dependency injection")

        %% ── Route Groups ────────────────────────────────────────────────
        %% KIND: router
        Component(login_routes, "Login Routes", "FastAPI APIRouter", "POST /login/access-token, POST /login/test-token, POST /password-recovery, POST /reset-password")

        %% KIND: router
        Component(user_routes, "User Routes", "FastAPI APIRouter", "CRUD for /users; signup, profile update, password change, admin user management")

        %% KIND: router
        Component(item_routes, "Item Routes", "FastAPI APIRouter", "CRUD for /items; owner-scoped access, superuser can see all")

        %% KIND: router
        Component(utils_routes, "Utils Routes", "FastAPI APIRouter", "GET /utils/health-check, POST /utils/test-email (superuser only)")

        %% ── Business Logic ──────────────────────────────────────────────
        %% KIND: service_layer
        Component(crud_layer, "CRUD Layer", "Python module (crud.py)", "create_user, update_user, get_user_by_email, authenticate, create_item")

        %% KIND: service_layer
        Component(email_utils, "Email Utilities", "Jinja2, emails library", "render_email_template, send_email, generate password-reset / new-account emails")

        %% ── Security ────────────────────────────────────────────────────
        %% KIND: service_layer
        Component(security_mod, "Security Module", "PyJWT, pwdlib (Argon2 + Bcrypt)", "create_access_token, verify_password, get_password_hash")

        %% ── Data Access ─────────────────────────────────────────────────
        %% KIND: data_access
        Component(models_layer, "Models", "SQLModel", "User, Item table models; Pydantic schemas for request/response validation")

        %% KIND: data_access
        Component(db_engine, "DB Engine", "SQLModel create_engine, Alembic", "SQLAlchemy engine creation; init_db seeds first superuser")

        %% ── Configuration ───────────────────────────────────────────────
        %% KIND: service_layer
        Component(core_config, "Core Config", "Pydantic Settings", "Loads env vars: DB connection, SMTP, secrets, CORS origins, Sentry DSN")
    }

    %% ── External elements (same stable IDs) ─────────────────────────────
    ContainerDb(pg, "PostgreSQL", "PostgreSQL 18", "Stores users and items")
    System_Ext(smtp, "SMTP Server", "Delivers transactional emails")
    System_Ext(sentry, "Sentry", "Error tracking")
    Container(spa, "React SPA", "React 19", "Frontend dashboard")

    %% ── Relationships ───────────────────────────────────────────────────
    Rel(spa, cors_mw, "API requests pass through CORS", "HTTPS")
    Rel(cors_mw, login_routes, "Forwards auth requests")
    Rel(cors_mw, user_routes, "Forwards user requests")
    Rel(cors_mw, item_routes, "Forwards item requests")
    Rel(cors_mw, utils_routes, "Forwards utility requests")

    Rel(login_routes, auth_deps, "Validates tokens")
    Rel(login_routes, crud_layer, "Authenticates users")
    Rel(login_routes, security_mod, "Creates JWT tokens")
    Rel(login_routes, email_utils, "Sends password recovery emails")

    Rel(user_routes, auth_deps, "Enforces authentication & authorization")
    Rel(user_routes, crud_layer, "User CRUD operations")
    Rel(user_routes, email_utils, "Sends new account emails")

    Rel(item_routes, auth_deps, "Enforces authentication")
    Rel(item_routes, models_layer, "Validates & persists items")

    Rel(utils_routes, auth_deps, "Superuser guard")
    Rel(utils_routes, email_utils, "Sends test emails")

    Rel(crud_layer, models_layer, "Queries & mutates models")
    Rel(crud_layer, security_mod, "Hashes & verifies passwords")
    Rel(crud_layer, db_engine, "Uses SQLModel Session")

    Rel(email_utils, core_config, "Reads SMTP settings")
    Rel(email_utils, smtp, "Sends emails via SMTP", "SMTP/TLS")

    Rel(security_mod, core_config, "Reads SECRET_KEY, algorithm")
    Rel(db_engine, core_config, "Reads SQLALCHEMY_DATABASE_URI")
    Rel(db_engine, pg, "Connects via psycopg", "PostgreSQL protocol")

    Rel(core_config, sentry, "Provides SENTRY_DSN")


