---
title: "L2: Container Diagram — Full Stack FastAPI Platform"
---

C4Container

    %% ── Actors ──────────────────────────────────────────────────────────
    Person(user, "User", "Registers, logs in, manages personal items")
    Person(admin_user, "Admin", "Manages users, views all items, sends test emails")

    %% ── Platform Boundary ───────────────────────────────────────────────
    Container_Boundary(platform_boundary, "Full Stack FastAPI Platform") {

        Container(spa, "React SPA", "React 19, TypeScript, Vite, TanStack Router, Tailwind CSS, shadcn/ui", "Single-page dashboard served via Nginx; auto-generated API client from OpenAPI spec")

        Container(fastapi_backend, "FastAPI Backend", "Python 3.10+, FastAPI, SQLModel, Pydantic, Uvicorn", "REST API serving /api/v1/*; JWT authentication, CRUD operations, email utilities")

        Container(prestart, "Prestart Job", "Python, Bash", "Runs DB migrations (Alembic) and seeds the first superuser before backend starts")

        ContainerDb(pg, "PostgreSQL", "PostgreSQL 18", "Stores users, items, and Alembic migration state")

        Container(traefik, "Traefik", "Traefik 3.6", "Reverse proxy and load balancer; terminates TLS via Let's Encrypt, routes to backend and frontend")

        Container(adminer, "Adminer", "Adminer (PHP)", "Lightweight database administration UI for PostgreSQL")
    }

    %% ── External Systems ────────────────────────────────────────────────
    System_Ext(smtp, "SMTP Server", "Delivers transactional emails")
    System_Ext(sentry, "Sentry", "Error tracking and performance monitoring")

    %% ── Relationships ───────────────────────────────────────────────────
    Rel(user, traefik, "Browses dashboard", "HTTPS")
    Rel(admin_user, traefik, "Manages users & system", "HTTPS")

    Rel(traefik, spa, "Proxies dashboard.*", "HTTP :80")
    Rel(traefik, fastapi_backend, "Proxies api.*", "HTTP :8000")
    Rel(traefik, adminer, "Proxies adminer.*", "HTTP :8080")

    Rel(spa, fastapi_backend, "Calls REST API", "HTTPS /api/v1/*")

    Rel(fastapi_backend, pg, "Reads/writes data", "PostgreSQL protocol (psycopg)")
    Rel(fastapi_backend, smtp, "Sends emails", "SMTP/TLS")
    Rel(fastapi_backend, sentry, "Reports errors", "HTTPS")

    Rel(prestart, pg, "Runs Alembic migrations, seeds superuser", "PostgreSQL protocol")

    Rel(adminer, pg, "Admin queries", "PostgreSQL protocol")


